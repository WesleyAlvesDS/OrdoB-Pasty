# ─── Google OAuth ─────────────────────────────────────────────
# Crie um projeto em https://console.cloud.google.com/
# Ative: Google Drive API, Google Docs API, Gmail API
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu-client-secret

# URLs de redirecionamento (dev)
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/callback

# ─── JWT ──────────────────────────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# ─── Frontend ─────────────────────────────────────────────────
FRONTEND_URL=http://localhost:5173

# ─── Banco de Dados ──────────────────────────────────────────
# PostgreSQL (padrão para produção)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/pasty

# ─── Rate Limiting ───────────────────────────────────────────
# Limites de requisições por minuto por IP
RATE_LIMIT_AUTH=20        # Rotas de autenticação (/api/auth/*)
RATE_LIMIT_SAVE=10        # Salvamento (/api/save)
RATE_LIMIT_HISTORY=30     # Histórico (/api/history)
RATE_LIMIT_DEFAULT=60     # Demais rotas /api/*

# ─── Redis (opcional) ────────────────────────────────────────
# Se configurado, o rate limiter usa Redis em vez de memória local,
# permitindo limites compartilhados entre múltiplas instâncias.
# Deixe vazio para usar o fallback in-memory.
REDIS_URL=

# ─── Servidor ────────────────────────────────────────────────
PORT=8000
